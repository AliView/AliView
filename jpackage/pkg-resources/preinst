#!/bin/sh
set -e

LEGACY_BIN="/usr/bin/aliview"
LEGACY_DESKTOP_SYS="/usr/share/applications/AliView.desktop"
LEGACY_SHARE_DIR="/usr/share/aliview"

is_legacy_aliview_wrapper() {
  f="$1"
  [ -f "$f" ] || return 1
  [ ! -L "$f" ] || return 1

  # Two strong fingerprints from the 2018 wrapper script
  grep -q 'Wrapper script version 29 Jan 2018' "$f" 2>/dev/null || return 1
  grep -q 'defprogdir="/usr/share/aliview"' "$f" 2>/dev/null || return 1
  return 0
}

# Remove legacy wrapper that shadows the new jpackage /usr/bin launcher.
if is_legacy_aliview_wrapper "$LEGACY_BIN"; then
  rm -f "$LEGACY_BIN"
fi

# Remove legacy desktop file if it looks like the old one.
if [ -f "$LEGACY_DESKTOP_SYS" ]; then
  if grep -q '^Exec=aliview' "$LEGACY_DESKTOP_SYS" 2>/dev/null; then
    rm -f "$LEGACY_DESKTOP_SYS"
  fi
fi

# Remove legacy share dir only if it contains the legacy jar.
if [ -d "$LEGACY_SHARE_DIR" ] && [ -f "$LEGACY_SHARE_DIR/aliview.jar" ]; then
  rm -rf "$LEGACY_SHARE_DIR"
fi

exit 0
